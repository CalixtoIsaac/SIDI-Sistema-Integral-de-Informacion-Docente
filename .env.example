# Copia este archivo como .env y completa los valores.

# Puerto del servidor
PORT=3000

# Clave para firmar las sesiones (mínimo 32 caracteres).
# Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si la dejas vacía en desarrollo, se usa una temporal (las sesiones se cierran al reiniciar).
JWT_SECRET=

# development | production  (en production el servidor no arranca sin JWT_SECRET)
NODE_ENV=development

# Ruta del archivo de la base de datos (opcional)
# DB_PATH=./data/app.db
